{%- comment -%} Open Graph + Twitter tags. Absolute image URL for link previews (Upwork, Slack, iMessage). {%- endcomment -%}
{%- liquid
  if settings.share_image != blank
    assign og_image = settings.share_image | image_url: width: 1200
  elsif page_image != blank
    assign og_image = page_image | image_url: width: 1200
  else
    assign og_image = brand | append: '-og.jpg' | asset_url
  endif
  unless og_image contains 'http'
    assign og_image = 'https:' | append: og_image
  endunless
  assign og_type = 'website'
  if request.page_type == 'product'
    assign og_type = 'product'
  endif
-%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:title" content="{{ page_title | escape }}">
<meta property="og:description" content="{{ page_description | default: shop.description | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:image" content="{{ og_image }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ page_title | escape }}">
<meta name="twitter:description" content="{{ page_description | default: shop.description | escape }}">
<meta name="twitter:image" content="{{ og_image }}">
