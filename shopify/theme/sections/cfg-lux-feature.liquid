{%- assign lb = template.suffix | default: settings.brand | split: '-' | first -%}
<section class="lx-feature lx-section"><div class="lx-feature__media" data-lx-reveal>{% assign asset = lb | append: '-campaign' %}{% render 'cfg-image', image: section.settings.image, asset: asset, width: 1600, height: 900, alt: section.settings.alt %}</div><div class="lx-feature__copy"><span class="lx-index">{{ section.settings.label | escape }}</span><h2 data-lx-reveal>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p><a class="lx-link" href="{% render 'cfg-lux-url', brand: lb, path: 'studio' %}">{{ section.settings.cta | escape }}{% render 'cfg-icon', name: 'arrow' %}</a></div></section>
{% schema %}
{"name":"Luxury brand feature","settings":[{"type":"text","id":"label","label":"Section label","default":"The studio"},{"type":"text","id":"heading","label":"Heading","default":"More than a beautiful object."},{"type":"textarea","id":"text","label":"Text"},{"type":"text","id":"cta","label":"Link label","default":"Inside the studio"},{"type":"image_picker","id":"image","label":"Photograph"},{"type":"text","id":"alt","label":"Image description"}],"presets":[{"name":"Luxury brand feature"}]}
{% endschema %}
