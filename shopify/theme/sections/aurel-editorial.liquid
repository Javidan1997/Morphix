<section class="cfg-section au-editorial" aria-labelledby="AuEd-{{ section.id }}">
  <div class="cfg-container au-editorial__grid">
    <p class="au-kicker">{{ section.settings.kicker }}</p>
    <h2 id="AuEd-{{ section.id }}" class="au-editorial__quote" data-reveal>{{ section.settings.quote }}</h2>
    <div class="au-editorial__body" data-reveal>{{ section.settings.text }}</div>
    <figure class="au-editorial__media" data-reveal>
      {%- render 'cfg-image', image: section.settings.image, asset: 'aurel-trio', width: 1600, height: 1000, alt: 'The Meridian in white, yellow and rose gold', sizes: '(min-width: 990px) 60vw, 100vw' -%}
      <figcaption>{{ section.settings.caption }}</figcaption>
    </figure>
  </div>
</section>

{% schema %}
{
  "name": "Aurel · Editorial",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The piece" },
    { "type": "textarea", "id": "quote", "label": "Quote" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "caption", "label": "Caption" }
  ],
  "presets": [{ "name": "Aurel · Editorial" }]
}
{% endschema %}
