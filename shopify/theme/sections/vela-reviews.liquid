{%- comment -%} Vela — testimonials. The "sample" label is a setting so a live store can drop it once real reviews exist. {%- endcomment -%}
<section class="cfg-section vela-reviews" id="reviews" aria-labelledby="RevTitle-{{ section.id }}">
  <div class="cfg-container">
    <div class="vela-head" data-reveal>
      <p class="cfg-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 id="RevTitle-{{ section.id }}" class="vela-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.sample_note != blank -%}
        <p class="vela-reviews__note"><span class="cfg-sample">Sample</span> {{ section.settings.sample_note }}</p>
      {%- endif -%}
    </div>
    <ul class="vela-reviews__list">
      {%- for block in section.blocks -%}
        <li class="vela-review" {{ block.shopify_attributes }} data-reveal style="transition-delay: {{ forloop.index0 | times: 70 }}ms">
          <figure>
            <p class="cfg-stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">{% for i in (1..block.settings.rating) %}{% render 'cfg-icon', name: 'star' %}{% endfor %}</p>
            <blockquote><p>{{ block.settings.quote }}</p></blockquote>
            <figcaption>
              <span class="vela-review__avatar" aria-hidden="true">{{ block.settings.name | slice: 0 }}</span>
              <span><strong>{{ block.settings.name }}</strong><span>{{ block.settings.detail }}</span></span>
            </figcaption>
          </figure>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Vela · Testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Calmer evenings, in their words" },
    { "type": "text", "id": "sample_note", "label": "Sample disclaimer", "default": "Illustrative testimonials written for this concept demo — not real customers." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Name", "default": "Alex" },
        { "type": "text", "id": "detail", "label": "Detail", "default": "Verified buyer" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Vela · Testimonials", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
