{%- assign lb = template.suffix | default: settings.brand | split: '-' | first -%}
<section id="introduction" class="lx-intro lx-intro--{{ lb }}">
  <div class="lx-intro__copy"><span class="lx-index">01 / {% if lb == 'forma' %}{{ 'lux.philosophy' | t }}{% else %}{{ 'lux.point_of_view' | t }}{% endif %}</span><h2 data-lx-words>{{ section.settings.heading | escape }}</h2><p data-lx-reveal>{{ section.settings.text | escape }}</p><a class="lx-link" href="{% render 'cfg-lux-url', brand: lb, path: 'studio' %}">{{ 'lux.our_story' | t }}{% render 'cfg-icon', name: 'arrow' %}</a></div>
  {% if lb == 'forma' %}<div class="lx-intro__pair"><figure data-lx-parallax="-0.07">{% render 'cfg-image', image: section.settings.image, asset: 'forma-detail', width: 800, height: 600, widths: '480,800', alt: 'Natural travertine detail' %}</figure><figure data-lx-parallax="0.08">{% render 'cfg-image', asset: 'forma-product-1', width: 800, height: 1000, widths: '480,800', alt: 'Arc lounge chair in sculpted walnut' %}</figure></div>
  {% else %}<div class="lx-drift-gallery"><div class="lx-drift-row" data-lx-drift="1">{% for n in (1..3) %}<figure>{% assign asset = 'edito-product-' | append: n %}{% render 'cfg-image', asset: asset, width: 800, height: 1600, widths: '480,800', alt: 'An individual silhouette from the collection' %}</figure>{% endfor %}</div><div class="lx-drift-row" data-lx-drift="-1">{% for n in (4..6) %}<figure>{% assign asset = 'edito-product-' | append: n %}{% render 'cfg-image', asset: asset, width: 800, height: 1600, widths: '480,800', alt: 'Tailoring and textures from the new edit' %}</figure>{% endfor %}</div></div>{% endif %}
</section>
{% schema %}
{"name":"Luxury manifesto","settings":[{"type":"text","id":"heading","label":"Heading","default":"Good design is felt. Every day."},{"type":"textarea","id":"text","label":"Story text"},{"type":"image_picker","id":"image","label":"Material photograph"}],"presets":[{"name":"Luxury manifesto"}]}
{% endschema %}
