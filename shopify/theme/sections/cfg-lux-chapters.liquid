{%- assign lb = template.suffix | default: settings.brand | split: '-' | first -%}
<section class="lx-chapters" data-lx-chapters aria-label="{{ section.settings.heading | escape }}"><div class="lx-chapters__stage">
{% for block in section.blocks %}<article class="lx-chapter" data-lx-chapter {{ block.shopify_attributes }}><div class="lx-chapter__image">{% assign asset = lb | append: '-' | append: block.settings.asset %}{% render 'cfg-image', image: block.settings.image, asset: asset, width: 1600, height: 900, alt: block.settings.alt %}</div><div class="lx-chapter__copy"><span>0{{ forloop.index }} / 0{{ section.blocks.size }}</span><h2>{{ block.settings.heading | escape }}</h2><p>{{ block.settings.text | escape }}</p><a class="lx-link" href="{% render 'cfg-lux-url', brand: lb, path: 'collection' %}">{{ 'lux.explore' | t }}{% render 'cfg-icon', name: 'arrow' %}</a></div></article>{% endfor %}
<div class="lx-chapter-dots">{% for block in section.blocks %}<button data-lx-chapter-jump="{{ forloop.index0 }}" aria-label="{{ block.settings.heading | escape }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"><span></span></button>{% endfor %}</div>
</div></section>
{% schema %}
{"name":"Luxury immersive chapters","settings":[{"type":"text","id":"heading","label":"Accessible section title","default":"A story in materials"}],"blocks":[{"type":"chapter","name":"Chapter","settings":[{"type":"text","id":"heading","label":"Heading","default":"Space to make your own."},{"type":"textarea","id":"text","label":"Text"},{"type":"image_picker","id":"image","label":"Photograph"},{"type":"text","id":"alt","label":"Image description"},{"type":"select","id":"asset","label":"Bundled campaign","options":[{"value":"scene","label":"Intimate scene"},{"value":"campaign","label":"New campaign"},{"value":"hero","label":"Opening campaign"}],"default":"scene"}]}],"max_blocks":3,"presets":[{"name":"Luxury immersive chapters","blocks":[{"type":"chapter"},{"type":"chapter"}]}]}
{% endschema %}
