{%- comment -%}
  Northgate — trade application.
  Uses Shopify's native create_customer form: the account is created with the
  `trade-applicant` tag and the business details as customer note fields.
  That fires the customers/create webhook → shopify/northgate/hubspot-webhook
  creates the HubSpot contact, company and "Trade application" deal. When sales
  approves in HubSpot, the same service swaps the tag to `trade-approved`,
  which unlocks tier pricing and the quick-order grid.
{%- endcomment -%}
<section class="cfg-section ng-apply" id="apply" aria-labelledby="NgApply-{{ section.id }}">
  <div class="cfg-container ng-apply__grid">
    <div>
      <p class="ng-kicker"><span></span>{{ section.settings.eyebrow }}</p>
      <h2 id="NgApply-{{ section.id }}" class="ng-h2">{{ section.settings.heading }}</h2>
      <ol class="ng-steps">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}><span class="ng-steps__n">0{{ forloop.index }}</span><span><strong>{{ block.settings.title }}</strong>{{ block.settings.text }}</span></li>
        {%- endfor -%}
      </ol>
    </div>
    <div class="ng-apply__card" data-cfg-form>
      {%- form 'create_customer', id: 'TradeApplication', class: 'ng-form' -%}
        <input type="hidden" name="customer[tags]" value="trade-applicant">
        <div class="ng-form__row">
          <div class="cfg-field"><label for="ta-first">First name</label><input class="cfg-input" id="ta-first" name="customer[first_name]" autocomplete="given-name" required></div>
          <div class="cfg-field"><label for="ta-last">Last name</label><input class="cfg-input" id="ta-last" name="customer[last_name]" autocomplete="family-name" required></div>
        </div>
        <div class="cfg-field"><label for="ta-company">Company</label><input class="cfg-input" id="ta-company" name="customer[note][Company]" autocomplete="organization" required></div>
        <div class="ng-form__row">
          <div class="cfg-field"><label for="ta-email">Work email</label><input class="cfg-input" id="ta-email" type="email" name="customer[email]" autocomplete="email" required></div>
          <div class="cfg-field"><label for="ta-tax">VAT / Tax ID</label><input class="cfg-input" id="ta-tax" name="customer[note][Tax ID]" autocomplete="off"></div>
        </div>
        <div class="ng-form__row">
          <div class="cfg-field">
            <label for="ta-type">Business type</label>
            <select class="cfg-input" id="ta-type" name="customer[note][Business type]" required>
              <option value="">Select…</option><option>E-commerce brand</option><option>3PL / fulfilment</option><option>Hospitality</option><option>Retail</option><option>Other</option>
            </select>
          </div>
          <div class="cfg-field">
            <label for="ta-volume">Monthly spend</label>
            <select class="cfg-input" id="ta-volume" name="customer[note][Monthly spend]" required>
              <option value="">Select…</option><option>Under $1,000</option><option>$1,000–5,000</option><option>$5,000–20,000</option><option>$20,000+</option>
            </select>
          </div>
        </div>
        <div class="cfg-field"><label for="ta-pass">Create a password</label><input class="cfg-input" id="ta-pass" type="password" name="customer[password]" autocomplete="new-password" minlength="8" required></div>
        <button type="submit" class="cfg-btn cfg-btn--primary cfg-btn--block">{{ section.settings.button_label }}</button>
        <p class="ng-form__legal">{{ section.settings.legal }}</p>
      {%- endform -%}
      <div class="cfg-success ng-success" data-form-success hidden role="status">
        {%- render 'cfg-icon', name: 'check' -%}
        <div>
          <p><strong>{{ section.settings.success_heading }}</strong></p>
          <p>{{ section.settings.success_text }}</p>
          {%- if settings.demo_mode -%}<p class="ng-success__demo">{{ 'cfg.demo.form_success' | t }}</p>{%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Northgate · Trade application",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Trade accounts" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Apply once. Order on terms." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Submit application" },
    { "type": "text", "id": "legal", "label": "Legal line" },
    { "type": "text", "id": "success_heading", "label": "Success heading", "default": "Application received" },
    { "type": "textarea", "id": "success_text", "label": "Success text" }
  ],
  "blocks": [{ "type": "step", "name": "Step", "settings": [{ "type": "text", "id": "title", "label": "Title" }, { "type": "text", "id": "text", "label": "Text" }] }],
  "max_blocks": 4,
  "presets": [{ "name": "Northgate · Trade application" }]
}
{% endschema %}
