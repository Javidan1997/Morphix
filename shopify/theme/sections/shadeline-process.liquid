{%- comment -%} Shadeline — delivery & installation steps. {%- endcomment -%}
<section class="cfg-section sl-process" id="delivery" aria-labelledby="SlProc-{{ section.id }}">
  <div class="cfg-container">
    <div class="sl-process__head">
      <div>
        <p class="sl-eyebrow sl-eyebrow--dark">{{ section.settings.eyebrow }}</p>
        <h2 id="SlProc-{{ section.id }}" class="sl-h2">{{ section.settings.heading }}</h2>
      </div>
      <p class="sl-process__lead">{{ section.settings.text }}</p>
    </div>
    <ol class="sl-steps">
      {%- for block in section.blocks -%}
        <li class="sl-steps__item" {{ block.shopify_attributes }} data-reveal style="transition-delay: {{ forloop.index0 | times: 80 }}ms">
          <p class="sl-steps__when">{{ block.settings.when }}</p>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
    <div class="sl-process__band" data-reveal>
      <div class="sl-process__media">
        {%- render 'cfg-image', image: section.settings.image, asset: 'shadeline-night', width: 1600, height: 1000, alt: 'Anthracite pergola at night with LED lighting and one side screen', sizes: '(min-width: 990px) 55vw, 100vw' -%}
      </div>
      <div class="sl-process__note">
        <h3>{{ section.settings.note_heading }}</h3>
        <div>{{ section.settings.note }}</div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shadeline · Delivery",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Delivery & installation" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From terrace to shade in five weeks." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "note_heading", "label": "Note heading", "default": "What we need from you" },
    { "type": "richtext", "id": "note", "label": "Note" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [{ "type": "text", "id": "when", "label": "When", "default": "Week 1" }, { "type": "text", "id": "title", "label": "Title" }, { "type": "textarea", "id": "text", "label": "Text" }] }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Shadeline · Delivery" }]
}
{% endschema %}
