{%- assign lb = template.suffix | default: settings.brand | split: '-' | first -%}
<section class="lx-hero" data-lx-hero aria-labelledby="LuxuryHero">
  <div class="lx-hero__frame" data-lx-hero-frame><div class="lx-hero__image" data-lx-parallax="0.17">
    {% assign hero_asset = lb | append: '-hero' %}{% render 'cfg-image', image: section.settings.image, asset: hero_asset, width: 1600, height: 900, alt: section.settings.alt, loading: 'eager', priority: true %}
    {% if section.settings.video != blank %}<video autoplay muted loop playsinline aria-hidden="true">{% for source in section.settings.video.sources %}<source src="{{ source.url }}" type="{{ source.mime_type }}">{% endfor %}</video>{% endif %}
  </div><div class="lx-hero__copy"><h1 id="LuxuryHero" data-lx-enter>{{ section.settings.heading | escape }}</h1><a class="lx-link" href="{% render 'cfg-lux-url', brand: lb, path: 'collection' %}">{{ section.settings.cta | escape }}{% render 'cfg-icon', name: 'arrow' %}</a></div><a class="lx-hero__scroll" href="#introduction">{{ 'lux.scroll' | t }}<span></span></a></div>
</section>
{% schema %}
{"name":"Luxury cinematic hero","settings":[{"type":"text","id":"heading","label":"Heading","default":"Live with intention."},{"type":"text","id":"cta","label":"Collection link","default":"Discover the collection"},{"type":"image_picker","id":"image","label":"Campaign photograph"},{"type":"video","id":"video","label":"Optional looping campaign film"},{"type":"text","id":"alt","label":"Image description","default":"A considered collection in natural light"}],"presets":[{"name":"Luxury cinematic hero"}]}
{% endschema %}
