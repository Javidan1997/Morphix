<section class="lc-hero" aria-labelledby="LcHero-{{ section.id }}">
  <div class="cfg-container lc-hero__grid">
    <div class="lc-hero__copy">
      <p class="lc-tag">{{ section.settings.eyebrow }}</p>
      <h1 id="LcHero-{{ section.id }}" class="lc-hero__title">{{ section.settings.heading }}</h1>
      <p class="lc-hero__text">{{ section.settings.text }}</p>
      <div class="lc-hero__actions">
        <a class="cfg-btn cfg-btn--primary" href="#check">{{ section.settings.button_label }}{% render 'cfg-icon', name: 'arrow' %}</a>
        <a class="lc-link" href="#compare">{{ section.settings.link_label }}</a>
      </div>
    </div>
    <div class="lc-hero__media">
      {%- render 'cfg-image', image: section.settings.image, asset: 'linkcore-hero', width: 1600, height: 1200, alt: 'Linkcore Dock 12 with ports on the front, a hub and cables', sizes: '(min-width: 990px) 55vw, 100vw', loading: 'eager', priority: true -%}
      <ul class="lc-hero__specs" aria-label="Dock 12 highlights">
        {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}><span>{{ block.settings.label }}</span>{{ block.settings.value }}</li>{%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Linkcore · Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Docks · Hubs · Display adapters" },
    { "type": "textarea", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Check my setup" },
    { "type": "text", "id": "link_label", "label": "Secondary link", "default": "Compare specs" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "blocks": [{ "type": "spec", "name": "Spec", "settings": [{ "type": "text", "id": "label", "label": "Label" }, { "type": "text", "id": "value", "label": "Value" }] }],
  "max_blocks": 4,
  "presets": [{ "name": "Linkcore · Hero" }]
}
{% endschema %}
