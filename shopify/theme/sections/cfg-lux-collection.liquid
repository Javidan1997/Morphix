{%- assign lb = template.suffix | default: settings.brand | split: '-' | first -%}{% assign items = collection.products %}{% if settings.demo_mode %}{% assign items = collections['luxury'].products %}{% endif %}
<section class="lx-shop lx-section"><header class="lx-page-heading"><span class="lx-index">{% if lb == 'forma' %}{{ 'lux.objects' | t }}{% else %}{{ 'lux.new_edit' | t }}{% endif %}</span><h1>{{ collection.title | default: section.settings.heading | escape }}</h1><p>{{ section.settings.text | escape }}</p></header><div class="lx-shop__toolbar"><div class="lx-filters" role="group" aria-label="{{ 'lux.filter' | t }}"><button data-lx-filter="all" aria-pressed="true">{{ 'lux.view_all' | t }}</button>{% assign categories = items | map: 'type' | uniq %}{% if settings.demo_mode %}{% assign categories = items | map: 'category' | uniq %}{% endif %}{% for category in categories %}{% if category != blank %}<button data-lx-filter="{{ category | escape }}" aria-pressed="false">{{ category | escape }}</button>{% endif %}{% endfor %}</div><label class="lx-sort">{{ 'lux.sort' | t }}<select data-lx-sort><option value="featured">{{ 'lux.featured' | t }}</option><option value="price-asc">{{ 'lux.price_low' | t }}</option><option value="price-desc">{{ 'lux.price_high' | t }}</option><option value="name">{{ 'lux.name_sort' | t }}</option></select></label></div><p class="lx-count" role="status" data-lx-count data-label="{{ 'lux.pieces' | t }}">{{ items.size }} {{ 'lux.pieces' | t }}</p><div class="lx-product-grid" data-lx-catalog>{% for item in items %}{% render 'cfg-lux-card', item: item, eager: forloop.first %}{% endfor %}</div></section>
{% schema %}
{"name":"Luxury collection page","settings":[{"type":"text","id":"heading","label":"Heading","default":"The collection"},{"type":"textarea","id":"text","label":"Introduction"}]}
{% endschema %}
