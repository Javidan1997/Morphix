{%- assign lb = template.suffix | default: settings.brand | split: '-' | first -%}
<section class="lx-look"><header class="lx-section-heading lx-section"><h2 data-lx-reveal>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p></header><div class="lx-look__scene">{% assign asset = lb | append: '-hero' %}{% render 'cfg-image', image: section.settings.image, asset: asset, width: 1600, height: 900, alt: section.settings.alt %}{% for block in section.blocks %}{% assign item = block.settings.product %}{% if settings.demo_mode %}{% assign item = all_products[block.settings.demo_handle] %}{% endif %}{% if item != blank %}<a class="lx-hotspot{% if block.settings.x > 60 %} lx-hotspot--left{% endif %}" href="{{ item.url }}" style="--x:{{ block.settings.x }}%;--y:{{ block.settings.y }}%" aria-label="{{ item.title | escape }}" {{ block.shopify_attributes }}><span class="lx-hotspot__dot">{% render 'cfg-icon', name: 'plus' %}</span><span class="lx-hotspot__label">{{ item.title | escape }} <small>{{ item.price | money_without_trailing_zeros }}</small></span></a>{% endif %}{% endfor %}</div></section>
{% schema %}
{"name":"Luxury shop the scene","settings":[{"type":"text","id":"heading","label":"Heading","default":"Make it your own."},{"type":"textarea","id":"text","label":"Text"},{"type":"image_picker","id":"image","label":"Scene photograph"},{"type":"text","id":"alt","label":"Image description"}],"blocks":[{"type":"hotspot","name":"Product hotspot","settings":[{"type":"product","id":"product","label":"Product"},{"type":"text","id":"demo_handle","label":"Concept fixture handle"},{"type":"range","id":"x","label":"Horizontal position","min":5,"max":95,"step":1,"default":50,"unit":"%"},{"type":"range","id":"y","label":"Vertical position","min":5,"max":95,"step":1,"default":50,"unit":"%"}]}],"max_blocks":4,"presets":[{"name":"Luxury shop the scene"}]}
{% endschema %}
