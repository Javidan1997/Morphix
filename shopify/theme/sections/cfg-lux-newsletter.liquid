<section id="newsletter" class="lx-newsletter lx-section" data-cfg-form><div><h2 data-lx-reveal>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p></div><div>{% form 'customer' %}<input type="hidden" name="contact[tags]" value="newsletter"><label for="LuxuryEmail-{{ section.id }}">{{ 'lux.email' | t }}</label><div class="lx-email-line"><input id="LuxuryEmail-{{ section.id }}" type="email" name="contact[email]" placeholder="{{ 'lux.email_placeholder' | t }}" required autocomplete="email"><button type="submit" aria-label="{{ 'lux.subscribe' | t }}">{% render 'cfg-icon', name: 'arrow' %}</button></div>{% if settings.demo_mode %}<small>{{ 'lux.form_demo' | t }}</small>{% endif %}{% endform %}<p data-form-success hidden role="status">{{ 'lux.subscribed' | t }}</p></div></section>
{% schema %}
{"name":"Luxury newsletter","settings":[{"type":"text","id":"heading","label":"Heading","default":"A little inspiration. Occasionally."},{"type":"textarea","id":"text","label":"Text","default":"New collections, considered spaces and the stories behind them."}],"presets":[{"name":"Luxury newsletter"}]}
{% endschema %}
