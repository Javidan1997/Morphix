{%- assign story_brand = template.suffix | default: settings.brand -%}
<section id="approach" class="motion-editorial motion-editorial--{{ story_brand }}" aria-labelledby="Editorial-{{ section.id }}">
  <h2 id="Editorial-{{ section.id }}" data-motion-reveal>{{ section.settings.heading | escape }}</h2>
  <div class="motion-editorial__images" data-drift-row>
    {%- for block in section.blocks -%}
      <figure {{ block.shopify_attributes }}>
        {%- assign photo_asset = story_brand | append: '-' | append: block.settings.asset -%}
        {%- render 'cfg-image', image: block.settings.image, asset: photo_asset, width: 800, height: 1000, widths: '480,800', alt: block.settings.alt, sizes: '(min-width: 760px) 32vw, 70vw' -%}
      </figure>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Drifting editorial",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Objects with a sense of belonging." }],
  "blocks": [{
    "type": "image", "name": "Editorial image",
    "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "alt", "label": "Image description", "default": "Campaign detail" },
      { "type": "select", "id": "asset", "label": "Bundled photograph", "options": [{"value":"detail","label":"Campaign detail"},{"value":"product-1","label":"First look"},{"value":"product-2","label":"Second look"},{"value":"product-3","label":"Third look"}], "default": "detail" }
    ]
  }],
  "max_blocks": 4,
  "presets": [{ "name": "Drifting editorial", "blocks": [{"type":"image"}] }]
}
{% endschema %}
