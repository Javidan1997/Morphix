<section class="cfg-section"><div class="cfg-container" style="max-width:480px">
  <h1>{{ shop.name }}</h1>
  <p class="cfg-muted">{{ section.settings.text }}</p>
  {%- form 'storefront_password' -%}
    <label class="cfg-label" for="pw">Password</label>
    <input class="cfg-input" id="pw" type="password" name="password" autocomplete="off" required>
    <button class="cfg-btn cfg-btn--primary" type="submit">Enter</button>
  {%- endform -%}
</div></section>
{% schema %}
{ "name": "Password", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Concept store opening soon." }] }
{% endschema %}
