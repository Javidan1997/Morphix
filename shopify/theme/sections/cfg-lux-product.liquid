{%- assign lb = template.suffix | default: settings.brand | split: '-' | first -%}
<div class="lx-breadcrumb"><a href="{% render 'cfg-lux-url', brand: lb %}">{{ 'lux.home' | t }}</a><span>/</span><a href="{% render 'cfg-lux-url', brand: lb, path: 'collection' %}">{{ 'lux.collection' | t }}</a><span>/</span><span>{{ product.title | escape }}</span></div>
<section class="lx-pdp" data-lx-product><div class="lx-pdp__gallery"><div class="lx-pdp__main" style="view-transition-name:product-{{ product.handle }}" data-lx-main-image>{% render 'cfg-image', image: product.featured_image, width: 800, height: 1000, widths: '480,800', alt: product.title, loading: 'eager', priority: true %}</div><div class="lx-pdp__lifestyle" data-lx-lifestyle hidden>{% assign campaign_asset = lb | append: '-campaign' %}{% render 'cfg-image', image: section.settings.image, asset: campaign_asset, width:1600,height:900,alt: section.settings.image_alt %}</div><div class="lx-thumbnails"><button data-lx-photo="product" aria-pressed="true" aria-label="{{ 'lux.product_view' | t }}">{% render 'cfg-image', image: product.featured_image, width: 480, height: 600, widths:'480',alt:product.title %}</button><button data-lx-photo="campaign" aria-pressed="false" aria-label="{{ 'lux.campaign_view' | t }}">{% render 'cfg-image', asset:campaign_asset,width:480,height:270,widths:'480',alt: section.settings.image_alt %}</button></div></div><div class="lx-pdp__info"><span class="lx-index">{{ product.category | default: product.type | escape }}</span><h1>{{ product.title | escape }}</h1><p class="lx-pdp__price" data-lx-price>{{ product.selected_or_first_available_variant.price | money_without_trailing_zeros }}</p><div class="lx-pdp__description">{{ product.description }}</div><script type="application/json" data-cfg-product>{{ product | json }}</script><cfg-product-form>{% assign product_form_id = 'LuxuryProduct-' | append: section.id %}{% form 'product', product, id: product_form_id %}<div class="lx-variant-field"><label for="LuxuryVariant">{% if lb == 'edito' %}{{ 'lux.size' | t }}{% else %}{{ 'lux.finish' | t }}{% endif %}</label>{% if lb == 'edito' %}<button type="button" class="lx-text-button" data-lx-size-open>{{ 'lux.size_guide' | t }}</button>{% endif %}<select name="id" id="LuxuryVariant" data-lx-variant>{% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price }}"{% if variant.id == product.selected_or_first_available_variant.id %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title | escape }}</option>{% endfor %}</select></div><div class="lx-quantity"><label for="LuxuryQuantity">{{ 'lux.quantity' | t }}</label><div><button type="button" data-lx-quantity="-1" aria-label="{{ 'lux.decrease' | t }}">{% render 'cfg-icon',name:'minus' %}</button><input type="number" name="quantity" id="LuxuryQuantity" value="1" min="1" max="10"><button type="button" data-lx-quantity="1" aria-label="{{ 'lux.increase' | t }}">{% render 'cfg-icon',name:'plus' %}</button></div></div><button type="submit" class="lx-button"{% unless product.available %} disabled{% endunless %}>{{ 'lux.add_bag' | t }}{% render 'cfg-icon',name:'plus' %}</button><p data-form-error role="alert" hidden></p>{% endform %}</cfg-product-form><p class="lx-pdp__note">{% if settings.demo_mode %}{{ 'lux.product_demo' | t }}{% endif %}</p><div class="lx-accordions"><details open><summary>{{ 'lux.material_fit' | t }}{% render 'cfg-icon', name:'plus' %}</summary><p>{{ product.material | default: section.settings.material | escape }}</p><p>{{ product.dimensions | default: section.settings.dimensions | escape }}</p></details><details><summary>{{ 'lux.delivery_care' | t }}{% render 'cfg-icon',name:'plus' %}</summary><p>{{ section.settings.care | escape }}</p></details><details><summary>{{ 'lux.need_help' | t }}{% render 'cfg-icon',name:'plus' %}</summary><p>{{ section.settings.help | escape }}</p><a href="{% render 'cfg-lux-url', brand:lb,path:'studio' %}">{{ 'lux.about' | t }}</a></details></div></div></section>
<section class="lx-pdp-banner"><div data-lx-parallax="0.09">{% render 'cfg-image', asset: campaign_asset,width:1600,height:900,alt:section.settings.image_alt %}</div><h2 data-lx-reveal>{{ section.settings.story_heading | escape }}</h2></section>
{% if settings.demo_mode %}<section class="lx-products lx-section"><header class="lx-section-heading"><h2>{{ 'lux.complete' | t }}</h2></header><div class="lx-product-grid">{% assign related_count = 0 %}{% for item in collections['luxury'].products %}{% unless item.handle == product.handle %}{% if related_count < 3 %}{% render 'cfg-lux-card',item:item %}{% assign related_count = related_count | plus:1 %}{% endif %}{% endunless %}{% endfor %}</div></section>{% endif %}
<dialog class="lx-size-dialog" id="LuxurySize"><button data-lx-size-close class="lx-dialog-close" aria-label="{{ 'lux.close' | t }}">{% render 'cfg-icon',name:'close' %}</button><h2>{{ 'lux.size_guide' | t }}</h2><p>{{ 'lux.size_note' | t }}</p><table><thead><tr><th>{{ 'lux.size' | t }}</th><th>{{ 'lux.bust' | t }}</th><th>{{ 'lux.waist' | t }}</th><th>{{ 'lux.hip' | t }}</th></tr></thead><tbody><tr><td>XS</td><td>80–84</td><td>62–66</td><td>86–90</td></tr><tr><td>S</td><td>84–88</td><td>66–70</td><td>90–94</td></tr><tr><td>M</td><td>88–94</td><td>70–76</td><td>94–100</td></tr><tr><td>L</td><td>94–100</td><td>76–82</td><td>100–106</td></tr></tbody></table></dialog>
{% schema %}
{"name":"Luxury product detail","settings":[{"type":"image_picker","id":"image","label":"Lifestyle photograph"},{"type":"text","id":"image_alt","label":"Lifestyle image description"},{"type":"text","id":"story_heading","label":"Story heading","default":"Designed for the way you live."},{"type":"textarea","id":"material","label":"Material details"},{"type":"text","id":"dimensions","label":"Dimensions or fit"},{"type":"textarea","id":"care","label":"Delivery and care","default":"This concept demonstrates the product experience. On a real store, material-specific care, shipping lead times and returns information belong here."},{"type":"textarea","id":"help","label":"Help text","default":"Explore the studio story for the thinking behind the collection. In a commissioned store, this space connects to the brand's client care team."}]}
{% endschema %}
