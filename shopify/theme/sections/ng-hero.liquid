<section class="ng-hero" aria-labelledby="NgHero-{{ section.id }}">
  <div class="cfg-container ng-hero__grid">
    <div class="ng-hero__copy">
      <p class="ng-kicker"><span></span>{{ section.settings.eyebrow }}</p>
      <h1 id="NgHero-{{ section.id }}" class="ng-hero__title">{{ section.settings.heading }}</h1>
      <p class="ng-hero__text">{{ section.settings.text }}</p>
      <div class="ng-hero__actions">
        <a class="cfg-btn cfg-btn--primary" href="#apply">{{ section.settings.button_label }}{% render 'cfg-icon', name: 'arrow' %}</a>
        <p class="ng-hero__login">{{ section.settings.login_text }} <a href="{{ routes.account_login_url }}" data-trade-login>{{ section.settings.login_label }}</a></p>
      </div>
    </div>
    <div class="ng-hero__media">
      {%- render 'cfg-image', image: section.settings.image, asset: 'northgate-hero', width: 1600, height: 1200, alt: 'Pallet of Northgate shipping boxes', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'eager', priority: true -%}
      <p class="ng-hero__tag"><span>NG-PAL-48</span> Mixed pallet · 48 cases</p>
    </div>
  </div>
  {%- if section.blocks.size > 0 -%}
    <div class="cfg-container">
      <ul class="ng-hero__facts">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}><strong>{{ block.settings.value }}</strong><span>{{ block.settings.label }}</span></li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Northgate · Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Wholesale packaging" },
    { "type": "textarea", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Apply for a trade account" },
    { "type": "text", "id": "login_text", "label": "Login text", "default": "Already approved?" },
    { "type": "text", "id": "login_label", "label": "Login link label", "default": "Log in for your prices" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "blocks": [{ "type": "fact", "name": "Fact", "settings": [{ "type": "text", "id": "value", "label": "Value" }, { "type": "text", "id": "label", "label": "Label" }] }],
  "max_blocks": 4,
  "presets": [{ "name": "Northgate · Hero" }]
}
{% endschema %}
