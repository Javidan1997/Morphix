{%- assign lb = template.suffix | default: settings.brand | split: '-' | first -%}{% assign entry = article | default: page %}
<article class="lx-article"><header class="lx-page-heading lx-section"><span class="lx-index">{% if template.name == 'article' %}{{ article.category | escape }}{% else %}{% if lb == 'forma' %}{{ 'lux.studio' | t }}{% else %}{{ 'lux.world' | t }}{% endif %}{% endif %}</span><h1>{{ entry.title | escape }}</h1>{% if article.intro %}<p>{{ article.intro | escape }}</p>{% endif %}</header><div class="lx-article__hero">{% assign article_asset = lb | append: '-campaign' %}{% assign article_image = section.settings.image | default: article.image %}<div data-lx-parallax="0.08">{% render 'cfg-image',image:article_image,asset:article_asset,width:1600,height:900,alt:entry.title,loading:'eager' %}</div></div><div class="lx-article__body">{% if settings.demo_mode and article.body %}{% for chapter in article.body %}<section data-lx-reveal><span class="lx-index">0{{ forloop.index }}</span><h2>{{ chapter[0] | escape }}</h2><p>{{ chapter[1] | escape }}</p></section>{% endfor %}{% else %}<div data-lx-reveal>{{ entry.content }}</div>{% if template.name == 'page' %}<section><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p></section>{% endif %}{% endif %}<a class="lx-link" href="{% render 'cfg-lux-url',brand:lb,path:'collection' %}">{{ 'lux.discover_collection' | t }}{% render 'cfg-icon',name:'arrow' %}</a></div></article>
{% schema %}
{"name":"Luxury story page","settings":[{"type":"image_picker","id":"image","label":"Story photograph"},{"type":"text","id":"heading","label":"Studio philosophy heading","default":"A considered approach."},{"type":"textarea","id":"text","label":"Studio philosophy text","default":"Proportion, material and the way something feels to live with. Every piece begins with these simple questions, and a belief that the most interesting objects leave room for the individual."}]}
{% endschema %}
