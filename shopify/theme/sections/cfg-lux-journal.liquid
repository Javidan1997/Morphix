{%- assign lb = template.suffix | default: settings.brand | split: '-' | first -%}{% assign entries = blog.articles | default: section.settings.blog.articles %}{% if settings.demo_mode %}{% assign entries = blogs['journal'].articles %}{% endif %}
<section class="lx-journal lx-section">{% if template.name == 'blog' %}<header class="lx-page-heading"><span class="lx-index">{{ 'lux.notes' | t }}</span><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.text | escape }}</p></header>{% else %}<header class="lx-section-heading"><h2 data-lx-reveal>{{ section.settings.heading | escape }}</h2><a class="lx-link" href="{% render 'cfg-lux-url', brand: lb, path: 'journal' %}">{{ 'lux.all_stories' | t }}{% render 'cfg-icon', name: 'arrow' %}</a></header>{% endif %}<div class="lx-journal__grid">{% for entry in entries limit:2 %}<article data-lx-reveal><a class="lx-journal__image" href="{{ entry.url }}">{% render 'cfg-image', image: entry.image, width: 1600, height: 900, alt: entry.title %}</a><p class="lx-index">{{ entry.category | escape }}</p><h3><a href="{{ entry.url }}">{{ entry.title | escape }}</a></h3><p>{{ entry.intro | default: entry.excerpt | strip_html | escape }}</p><a class="lx-link" href="{{ entry.url }}">{{ 'lux.read_story' | t }}{% render 'cfg-icon', name: 'arrow' %}</a></article>{% endfor %}</div></section>
{% schema %}
{"name":"Luxury journal","settings":[{"type":"text","id":"heading","label":"Heading","default":"Stories to spend time with."},{"type":"textarea","id":"text","label":"Introduction"},{"type":"blog","id":"blog","label":"Blog"}],"presets":[{"name":"Luxury journal"}]}
{% endschema %}
