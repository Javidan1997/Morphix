{%- assign lb = template.suffix | default: settings.brand | split: '-' | first -%}
{% assign entries = blog.articles | default: section.settings.blog.articles %}
{% if settings.demo_mode %}{% assign entries = blogs['journal'].articles %}{% endif %}
<section class="lx-journal lx-section">
  {% if template.name == 'blog' %}
    <header class="lx-page-heading"><span class="lx-index">{{ 'lux.notes' | t }}</span><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.text | escape }}</p></header>
    {% if settings.demo_mode %}
      {% render 'cfg-lux-journal-grid', entries: entries, brand: lb %}
    {% else %}
      {% paginate blog.articles by 12 %}
        {% render 'cfg-lux-journal-grid', entries: blog.articles, brand: lb %}
        {% render 'cfg-lux-pagination', paginate: paginate %}
      {% endpaginate %}
    {% endif %}
  {% else %}
    <header class="lx-section-heading"><h2 data-lx-reveal>{{ section.settings.heading | escape }}</h2><a class="lx-link" href="{% render 'cfg-lux-url', brand: lb, path: 'journal' %}">{{ 'lux.all_stories' | t }}{% render 'cfg-icon', name: 'arrow' %}</a></header>
    {% render 'cfg-lux-journal-grid', entries: entries, brand: lb, limit: 2 %}
  {% endif %}
</section>
{% schema %}
{"name":"Luxury journal","settings":[{"type":"text","id":"heading","label":"Heading","default":"Stories to spend time with."},{"type":"textarea","id":"text","label":"Introduction"},{"type":"blog","id":"blog","label":"Blog"}],"presets":[{"name":"Luxury journal"}]}
{% endschema %}
