{%- comment -%}
  Vela — ingredient breakdown. Reads the product's `custom.ingredients`
  metafield (list of "ingredient" metaobjects: name, dose_mg, role, source,
  detail). Falls back to section blocks when the metafield is empty, so the
  section also works on a store that hasn't created the metaobjects yet.
{%- endcomment -%}
{%- liquid
  assign source_product = section.settings.product | default: product
  assign ingredients = source_product.metafields.custom.ingredients.value
  assign max_dose = 0
  if ingredients != blank
    for i in ingredients
      assign d = i.dose_mg.value | plus: 0
      if d > max_dose
        assign max_dose = d
      endif
    endfor
  else
    for block in section.blocks
      assign d = block.settings.dose_mg | plus: 0
      if d > max_dose
        assign max_dose = d
      endif
    endfor
  endif
-%}
<section class="cfg-section vela-ingredients" id="ingredients" aria-labelledby="IngTitle-{{ section.id }}">
  <div class="cfg-container vela-ingredients__grid">
    <div class="vela-ingredients__media" data-reveal>
      {%- render 'cfg-image', image: section.settings.image, asset: 'vela-capsules', width: 1600, height: 1200, alt: 'Two-tone Vela capsules scattered beside the jar', sizes: '(min-width: 990px) 45vw, 100vw' -%}
      <ul class="vela-free">
        {%- assign frees = section.settings.free_from | split: ',' -%}
        {%- for f in frees -%}<li>{{ f | strip }}</li>{%- endfor -%}
      </ul>
    </div>
    <div class="vela-ingredients__body">
      <div class="vela-head vela-head--left" data-reveal>
        <p class="cfg-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 id="IngTitle-{{ section.id }}" class="vela-h2">{{ section.settings.heading }}</h2>
        <p class="vela-serving">{{ section.settings.serving }}</p>
      </div>
      <ul class="vela-ing-list">
        {%- if ingredients != blank -%}
          {%- for i in ingredients -%}
            {%- render 'vela-ingredient', name: i.name.value, dose: i.dose_mg.value, role: i.role.value, source: i.source.value, detail: i.detail.value, max: max_dose, index: forloop.index -%}
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            {%- render 'vela-ingredient', name: block.settings.name, dose: block.settings.dose_mg, role: block.settings.role, source: block.settings.source, detail: block.settings.detail, max: max_dose, index: forloop.index, attrs: block.shopify_attributes -%}
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vela · Ingredients",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Defaults to the page's product." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What's inside" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four ingredients. Nothing to hide." },
    { "type": "text", "id": "serving", "label": "Serving note", "default": "Per 2-capsule serving" },
    { "type": "text", "id": "free_from", "label": "Free-from list (comma separated)", "default": "No melatonin, Vegan capsule, Non-GMO, Third-party tested" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient (fallback)",
      "settings": [
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "number", "id": "dose_mg", "label": "Dose (mg)" },
        { "type": "text", "id": "role", "label": "Role" },
        { "type": "text", "id": "source", "label": "Source" },
        { "type": "textarea", "id": "detail", "label": "Detail" }
      ]
    }
  ],
  "presets": [{ "name": "Vela · Ingredients" }]
}
{% endschema %}
