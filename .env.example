VITE_ADMIN_EMAIL=admin@configuro.studio
VITE_ADMIN_PASSWORD=adminConfiguro

# Optional production backend values when you connect the forms to Supabase Free plan.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_ERPNEXT_SYNC_URL=

# ERPNext integration for automated lead + quotation sync (Supabase Edge Function secrets)
ERPNEXT_BASE_URL=https://erp.yourdomain.com
ERPNEXT_API_KEY=your-erpnext-api-key
ERPNEXT_API_SECRET=your-erpnext-api-secret
# Optional combined auth format as key:secret
ERPNEXT_API_TOKEN=
ERPNEXT_ENABLE_QUOTATION=true
ERPNEXT_COMPANY=Your Company Name
ERPNEXT_QUOTATION_ITEM_CODE=DISCOVERY-SCOPE
ERPNEXT_QUOTATION_ITEM_NAME=Discovery and Scope
ERPNEXT_QUOTATION_CURRENCY=USD
ERPNEXT_DEFAULT_RATE=0
