{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/pergola-configurators", "destination": "/pergola-configurator", "permanent": true },
    { "source": "/pergola-configurators/", "destination": "/pergola-configurator", "permanent": true }
  ],
  "rewrites": [
    { "source": "/pergola-configurator", "destination": "/pergola-configurator.html" },
    {
      "source": "/((?!api/|assets/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
